# Required external services
JINA_API_KEY=replace-with-jina-api-key
JINA_EMBEDDING_URL=https://api.jina.ai/v1/embeddings
JINA_MODEL=jina-embeddings-v3
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
FALLBACK_MODEL=jina-embeddings-v3

NEBIUS_API_KEY=replace-with-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=google/gemma-3-27b-it
GROQ_API_KEY=replace-with-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
# Dedicated safety policy classifier. Set GUARDRAIL_PROVIDER=nemo only to
# roll back to the legacy NeMo flow after an incident.
GROQ_SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b
GROQ_SAFEGUARD_TIMEOUT_SECONDS=15
GUARDRAIL_PROVIDER=groq_safeguard
JUDGE_GROQ_API_KEY=replace-with-dedicated-eval-judge-key
USE_PORTKEY=false

QDRANT_URL=https://replace-with-qdrant-endpoint
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=enterprise_rag
NEON_DB_URL=postgresql://user:password@host/database?sslmode=require
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-endpoint
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# Application behavior
RAG_API_KEY=replace-with-a-long-random-api-key
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_UPLOAD_BYTES=26214400
MAX_CONVERSATION_MESSAGES=20
CONVERSATION_HISTORY_TTL_SECONDS=2592000
LLM_TEMPERATURE=0.1
LLM_SEED=42
LLM_FREQUENCY_PENALTY=0.1
# Idle/read timeout for Nebius/Groq planner and generation calls.
LLM_REQUEST_TIMEOUT_SECONDS=45

# Optional observability and semantic memory
MEM0_API_KEY=
LOGFIRE_TOKEN=
LOGFIRE_PROJECT=enterprise-rag
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rag
